# =====================================================
# Saloon Backend — Environment Variables
# =====================================================
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# Server başlarken src/config/env.ts zod ile validate eder — eksik/geçersiz değer varsa başlamaz.

# === Server ===
NODE_ENV=development
PORT=3000

# === Database (DATABASE_URL varsa o kullanılır, yoksa DB_* gerekli) ===
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saloon_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# === JWT — ZORUNLU, en az 32 karakter ===
# Üretmek için: openssl rand -hex 32
JWT_SECRET=replace_me_with_32_char_minimum_random_secret_for_dev

# === CORS — virgülle ayrılmış origin listesi ===
# Development: localhost + Capacitor
# Production: spesifik domain (örn: https://app.example.com)
# ALLOWED_ORIGINS içinde '*' olmamalı NODE_ENV=production iken
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,app://.

# === Türkiye API ===
TURKIYE_API_BASE_URL=https://turkiyeapi.dev/api/v1

# === Google Maps (opsiyonel) ===
GOOGLE_MAPS_API_KEY=

# === Firebase (opsiyonel) ===
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === OpenAI (opsiyonel — AI asistan için) ===
# OPENAI_API_KEY=sk-...

# === SMTP (opsiyonel — e-posta için) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# === Sentry (opsiyonel — error monitoring) ===
# SENTRY_DSN=https://...@sentry.io/...

# === Base URL (iyzico callback'leri için) ===
BASE_URL=http://localhost:3000

# === Redis (opsiyonel — cache/session) ===
# REDIS_URL=redis://localhost:6379
